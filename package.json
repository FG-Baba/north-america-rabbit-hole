{
  "name": "north-america-rabbit-hole",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "npm run build && node --test tests/rendered-html.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.69.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "^16.4.6",
    "react-server-dom-webpack": "^19.3.1",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "^8.3.8",
    "wrangler": "4.92.0"
  },
  "overrides": {
    "postcss": "^8.5.14",
    "esbuild": "^0.28.0",
    "fflate": "^0.8.2",
    "brace-expansion": "^5.0.7",
    "fast-uri": "^3.1.5",
    "js-yaml": "^4.1.2",
    "nanoid": "^3.3.13",
    "source-map-js": "^1.2.2",
    "zod": "^4.4.4",
    "browserslist": "^4.28.3",
    "minimatch": "^11.0.1",
    "baseline-browser-mapping": "^2.10.31",
    "undici": "^7.30.1",
    "ws": "^8.21.0",
    "sharp": "^0.35.5",
    "image-size": "^2.1.0",
    "satori": "^0.33.5"
  },
  "type": "module",
  "description": "Interactive visual story on how plate tectonics, watersheds, Indigenous Nations, and treaties shaped North America",
  "license": "MIT"
}